# Copy to .env.local and fill in values for local development.

# PostgreSQL. Locally use localhost; on Vercel/Neon use the pooled URL here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arteria?schema=public"
# Same as DATABASE_URL locally. On Vercel/Neon: the *non-pooling* / direct URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/arteria?schema=public"

WEBSITE_URL="http://localhost:3000"

# Admin at /admin: one shared password; the secret signs the session cookie.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob for media uploaded in the admin.
# On Vercel: link a Blob store (BLOB_STORE_ID + OIDC are set automatically).
# Elsewhere (Docker/EC2): set BLOB_READ_WRITE_TOKEN from the Blob store settings.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=
# Optional: your store's public host, e.g. xxxx.public.blob.vercel-storage.com
BLOB_HOSTNAME=

# Contact requests are also forwarded to this Telegram chat (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
